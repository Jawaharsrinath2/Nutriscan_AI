# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
backend/.env

# ---- Python (backend) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Backend runtime data ----
backend/storage/
backend/models/*.pt
backend/models/*.onnx
backend/training/runs/
backend/training/datasets/

# ---- Node / Vite (frontend) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs & temp ----
*.log
*.tmp
